# Copy this file to .env and fill in the values. NEVER commit .env or share it.
DATABASE_URL=postgresql://support:support_dev_password@localhost:5433/support
REDIS_URL=redis://localhost:6379/0
GEMINI_API_KEY=put-your-key-here
# Long random value, used to hash customer ids in logs. The default is NOT secure.
LOG_HASH_SECRET=change-me-to-a-long-random-string
# Set to false if your privacy rules forbid logging the (redacted) message text.
LOG_MESSAGE_TEXT=true
# Long random value used to sign login sessions. The default is NOT secure.
SESSION_SECRET=change-me-to-another-long-random-string
# Demo login lets you pick a test customer. Set to false when a real login system provides the customer id.
DEMO_LOGIN=true
# Set to true when the site is served over HTTPS.
COOKIE_SECURE=false
